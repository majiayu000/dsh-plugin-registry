{
  "name": "dsh-plugin-registry-ui",
  "version": "0.1.0",
  "license": "MIT",
  "description": "Searchable DeepSeek Harness plugin registry with curated listings and manifest-verified GitHub discovery.",
  "private": true,
  "type": "module",
  "homepage": "https://plugin.dshdesk.com/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/majiayu000/dsh-plugin-registry.git"
  },
  "bugs": {
    "url": "https://github.com/majiayu000/dsh-plugin-registry/issues"
  },
  "keywords": [
    "deepseek-harness",
    "dsh-plugin",
    "plugin-registry",
    "plugin-discovery"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "vite",
    "dev:cloudflare": "npm run build && wrangler pages dev dist",
    "build": "vite build",
    "postbuild": "node scripts/generate-seo.mjs",
    "deploy:cloudflare": "npm run build && wrangler pages deploy dist --project-name dsh-plugin-registry --branch main",
    "preview": "vite preview",
    "backfill:categories": "node scripts/backfill-categories.mjs",
    "backfill:languages": "node scripts/backfill-languages.mjs",
    "sync:plugins": "node scripts/sync-plugins.mjs",
    "validate:registry": "node scripts/validate-registry.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:e2e": "playwright test"
  },
  "devDependencies": {
    "@playwright/test": "^1.62.1",
    "vite": "^7.1.1",
    "wrangler": "^4.123.0"
  }
}
