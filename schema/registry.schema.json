{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/majiayu000/dsh-plugin-registry/main/schema/registry.schema.json",
  "title": "DeepSeek Harness plugin registry",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "categories", "stats", "sources", "plugins"],
  "properties": {
    "schemaVersion": { "const": 2 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "categories": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["zh", "en"],
        "properties": {
          "zh": { "type": "string", "minLength": 1 },
          "en": { "type": "string", "minLength": 1 }
        }
      }
    },
    "stats": { "type": "object" },
    "sources": { "type": "object" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "owner", "url", "description", "category", "stars", "forks", "source", "trustLevel", "verification", "install", "icon"],
        "not": {
          "anyOf": [
            { "required": ["verified"] },
            { "required": ["installable"] }
          ]
        },
        "properties": {
          "id": { "type": "string", "pattern": "^[^/]+/[^/#]+(?:#[^/#]+)?$" },
          "name": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+" },
          "description": {
            "type": "object",
            "required": ["zh", "en"],
            "properties": {
              "zh": { "type": "string" },
              "en": { "type": "string" }
            }
          },
          "category": { "type": "string", "minLength": 1 },
          "stars": { "type": "integer", "minimum": 0 },
          "forks": { "type": "integer", "minimum": 0 },
          "language": { "type": "string" },
          "license": { "type": "string" },
          "latestRelease": {
            "anyOf": [
              {
                "type": "object",
                "required": ["tag", "publishedAt"],
                "additionalProperties": false,
                "properties": {
                  "tag": { "type": "string" },
                  "publishedAt": {
                    "anyOf": [
                      { "type": "string", "format": "date-time" },
                      { "type": "null" }
                    ]
                  }
                }
              },
              { "type": "null" }
            ]
          },
          "pushedAt": {
            "anyOf": [
              { "type": "string", "format": "date-time" },
              { "type": "null" }
            ]
          },
          "verifiedCommit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
          "source": { "enum": ["curated", "discovered"] },
          "trustLevel": { "enum": ["curated", "manifest_verified"] },
          "special": { "type": "boolean" },
          "recommendationSource": { "enum": ["x"] },
          "origin": { "enum": ["issue"] },
          "verification": {
            "type": "object",
            "required": ["manifest", "patch", "installation"],
            "additionalProperties": false,
            "properties": {
              "manifest": { "enum": ["not_checked", "shape_validated"] },
              "patch": { "enum": ["not_checked", "exists", "missing"] },
              "installation": { "const": "not_tested" }
            }
          },
          "install": { "type": "string", "pattern": "^dsh plugin --profile [A-Za-z0-9._-]+ add [^\\s]+$" },
          "icon": { "type": "string", "pattern": "^https://(?:github\\.com|avatars\\.githubusercontent\\.com)/" }
        }
      }
    }
  }
}
