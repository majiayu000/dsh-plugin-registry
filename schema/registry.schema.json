{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://registry.deepseek-harness.dev/schema/registry.schema.json",
  "title": "DeepSeek Harness plugin registry",
  "type": "object",
  "required": ["schemaVersion", "generatedAt", "categories", "stats", "sources", "plugins"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "generatedAt": { "type": "string", "format": "date-time" },
    "categories": { "type": "object" },
    "stats": { "type": "object" },
    "sources": { "type": "object" },
    "plugins": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "owner", "url", "description", "category", "stars", "forks", "source", "trustLevel", "verified", "installable", "install", "icon"],
        "properties": {
          "id": { "type": "string", "pattern": "^[^/]+/[^/#]+(?:#[^/#]+)?$" },
          "name": { "type": "string", "minLength": 1 },
          "owner": { "type": "string", "minLength": 1 },
          "url": { "type": "string", "pattern": "^https://github\\.com/[^/]+/[^/]+" },
          "description": { "type": "object", "required": ["zh", "en"] },
          "category": { "type": "string", "minLength": 1 },
          "stars": { "type": "integer", "minimum": 0 },
          "forks": { "type": "integer", "minimum": 0 },
          "source": { "enum": ["curated", "discovered"] },
          "trustLevel": { "enum": ["curated", "manifest_verified"] },
          "verified": { "const": true },
          "installable": { "const": true },
          "install": { "type": "string", "pattern": "^dsh plugin --profile web add [^\\s]+$" },
          "icon": { "type": "string", "pattern": "^https://" }
        }
      }
    }
  }
}
